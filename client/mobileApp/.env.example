# Base URL of the Tenementary API (v1).
#
# Leave this unset during local development: the app reads the machine's LAN
# address from Metro's hostUri, so it keeps working when the router hands the
# machine a new IP. Unset it to get that behaviour:
#
#   EXPO_PUBLIC_API_URL=http://<your-lan-ip>:4000/api/v1
#
# A pinned LAN address goes stale when the DHCP lease changes — the symptom is
# the login screen hanging until it times out. Set it only for a staging or
# deployed host.
# EXPO_PUBLIC_API_URL=

# Log every request verb + URL to the Metro console (dev only)
EXPO_PUBLIC_API_DEBUG=false